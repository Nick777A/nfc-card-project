<!DOCTYPE html>
<html lang="en">
<head>
  <title>Order an NFC card — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
  <nav class="dl-nav">
    <a class="dl-logo" href="/">digilama</a>
    <div class="dl-nav-links">
      <a href="/customer/login">My account</a>
    </div>
  </nav>

  <div class="dl-container narrow" style="padding-bottom:60px;">
    <div class="dl-card">
      <h1 style="margin-top:0;">Place an order</h1>

      <% if (error) { %><div class="dl-error"><%= error %></div><% } %>

      <form method="post" action="/order" id="order-form" enctype="multipart/form-data">
        <div class="dl-field">
          <label>Who is this card for?</label>
          <div class="dl-choice-group" id="kind-group">
            <label class="dl-choice"><input type="radio" name="kind" value="person" <%= values.kind !== 'organization' ? 'checked' : '' %> /><div class="dl-choice-title">For myself</div><div class="dl-choice-sub">A single personal card</div></label>
            <label class="dl-choice"><input type="radio" name="kind" value="organization" <%= values.kind === 'organization' ? 'checked' : '' %> /><div class="dl-choice-title">For an organization</div><div class="dl-choice-sub">Multiple cards for a team</div></label>
          </div>
        </div>

        <div class="dl-field">
          <label for="quantity">Number of cards</label>
          <input type="number" id="quantity" name="quantity" min="1" max="500" value="<%= values.quantity || 1 %>" />
        </div>

        <div class="dl-field">
          <label>Design</label>
          <div class="dl-choice-group cols-3" id="design-group">
            <% Object.keys(designOptions).forEach(function(key) { %>
              <label class="dl-choice">
                <input type="radio" name="design" value="<%= key %>" <%= (values.design || 'classic') === key ? 'checked' : '' %> />
                <div class="dl-choice-title"><%= designOptions[key].label %></div>
                <div class="dl-choice-sub"><%= designOptions[key].pricePerCard > 0 ? '+' + designOptions[key].pricePerCard.toFixed(2) + '€' : 'Included' %></div>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="dl-field" id="design-image-field" style="display:none;">
          <label for="designImage">Upload your logo / image</label>
          <input type="file" id="designImage" name="designImage" accept="image/*" />
          <p class="dl-hint">Needed for printing on the card or for the sticker.</p>
        </div>

        <div class="dl-field">
          <label>Card preview</label>
          <div class="dl-card-preview">
            <div class="dl-preview-card front" id="preview-front">
              <img id="preview-logo-img" class="dl-preview-logo-img" style="display:none;" alt="" />
              <img id="preview-sticker-img" class="dl-preview-sticker" style="display:none;" alt="" />
              <div class="dl-preview-name" id="preview-name">Your name</div>
              <div class="dl-preview-brand">digilama</div>
            </div>
            <div class="dl-preview-card back">
              <div class="dl-preview-qr"><span></span></div>
              <div class="dl-preview-caption">Card QR code</div>
            </div>
          </div>
          <p class="dl-hint">Left — front side, right — back side (always shows this card's QR code).</p>
        </div>

        <div class="dl-summary" id="price-summary">
          <div class="dl-summary-row"><span>Price per card</span><span id="price-per-card">—</span></div>
          <div class="dl-summary-row"><span>Quantity</span><span id="price-qty">—</span></div>
          <div class="dl-summary-row total"><span>Total</span><span id="price-total">—</span></div>
        </div>

        <div class="dl-field">
          <label for="contactName">Your name (contact person)</label>
          <input type="text" id="contactName" name="contactName" value="<%= values.contactName || '' %>" required />
        </div>

        <div class="dl-row">
          <div class="dl-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= values.email || '' %>" required />
          </div>
          <div class="dl-field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" />
          </div>
        </div>

        <div class="dl-field" id="company-field" style="display:none;">
          <label for="company">Organization name</label>
          <input type="text" id="company" name="company" value="<%= values.company || '' %>" />
        </div>

        <div class="dl-field">
          <label for="cardDetailsNote">What should be on the card(s)</label>
          <textarea id="cardDetailsNote" name="cardDetailsNote" placeholder="Name, job title, social links, etc. If ordering several cards, list the details for each one."><%= values.cardDetailsNote || '' %></textarea>
        </div>

        <div class="dl-field">
          <label for="shippingAddress">Shipping address</label>
          <textarea id="shippingAddress" name="shippingAddress"><%= values.shippingAddress || '' %></textarea>
        </div>

        <div class="dl-field">
          <label for="password">Password for your account</label>
          <input type="password" id="password" name="password" minlength="6" required />
          <p class="dl-hint">You'll use this later to edit your card's details yourself.</p>
        </div>
        <div class="dl-field">
          <label for="confirmPassword">Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" required />
        </div>

        <button type="submit" class="dl-btn primary block">Submit order</button>
        <p class="dl-hint" style="text-align:center;">This is a request, not a payment — we'll contact you using the details above to confirm everything and arrange payment.</p>
      </form>
    </div>
  </div>

  <script src="/js/order.js"></script>
</body>
</html>
