<!DOCTYPE html>
<html lang="en">
<head>
  <title>Order received — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
  <nav class="dl-nav">
    <a class="dl-logo" href="/">digilama</a>
    <div class="dl-nav-links"><a href="/my">My account</a></div>
  </nav>

  <div class="dl-container narrow" style="padding-bottom:60px;">
    <div class="dl-card">
      <div class="dl-success">Order #<%= order.id.slice(0, 8) %> received! We'll contact you using the details you provided to confirm everything and arrange payment.</div>
      <h1 style="margin-top:0;">Your order</h1>
      <div class="dl-summary">
        <div class="dl-summary-row"><span>Type</span><span><%= order.kind === 'organization' ? 'For an organization' : 'For myself' %></span></div>
        <div class="dl-summary-row"><span>Design</span><span><%= designOptions[order.design].label %></span></div>
        <div class="dl-summary-row"><span>Quantity</span><span><%= order.quantity %></span></div>
        <div class="dl-summary-row"><span>Price per card</span><span><%= order.pricePerCard.toFixed(2) %>€</span></div>
        <div class="dl-summary-row total"><span>Total</span><span><%= order.totalPriceEur.toFixed(2) %>€</span></div>
      </div>
      <p class="dl-hint">An account has already been created with your email — you're signed in automatically. Once your card is ready, it will appear under "My cards", and you'll be able to edit its details at any time.</p>
      <a href="/my" class="dl-btn primary block">Go to my account</a>
    </div>
  </div>
</body>
</html>
