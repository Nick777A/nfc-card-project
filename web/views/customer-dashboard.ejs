<!DOCTYPE html>
<html lang="en">
<head>
  <title>My account — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
  <nav class="dl-nav">
    <a class="dl-logo" href="/">digilama</a>
    <div class="dl-nav-links">
      <a href="/order">+ New order</a>
      <form method="post" action="/customer/logout" style="margin:0;">
        <button type="submit" style="background:none; border:none; color:var(--muted); font:inherit; cursor:pointer; font-weight:600;">Log out</button>
      </form>
    </div>
  </nav>

  <div class="dl-container" style="padding-bottom:60px;">
    <div class="dl-my-header">
      <div>
        <p class="dl-hint" style="margin:0 0 4px; text-transform:uppercase; letter-spacing:0.5px; font-size:11px; font-weight:700;">My account</p>
        <h1 style="margin:0;">Hi, <%= (customer && (customer.contactName || customer.company)) || 'there' %> 👋</h1>
      </div>
      <div class="dl-my-stats">
        <div class="dl-my-stat"><strong><%= cards.length %></strong><span>card<%= cards.length === 1 ? '' : 's' %></span></div>
        <div class="dl-my-stat"><strong><%= cards.reduce(function(sum, c) { return sum + (c.viewCount || 0); }, 0) %></strong><span>total taps</span></div>
      </div>
    </div>

    <% if (cards.length === 0) { %>
      <div class="dl-card dl-my-empty">
        <div class="dl-my-empty-icon">💳</div>
        <p style="margin:0 0 4px; font-weight:700;">No cards yet</p>
        <p class="dl-hint" style="margin:0 0 18px;">Once your order is processed, your card will show up here — you'll be able to edit its details, links and look any time.</p>
        <a href="/order" class="dl-btn primary" style="padding:10px 22px;">Order a card</a>
      </div>
    <% } else { %>
      <div class="dl-mycards-grid">
        <% cards.forEach(function(card) { %>
          <% var t1 = (card.theme && card.theme.accentColor1) || '#ff2e88'; var t2 = (card.theme && card.theme.accentColor2) || '#00e6c3'; %>
          <div class="dl-mycard-tile">
            <div class="dl-mycard-top">
              <div class="dl-mycard-avatar" style="background:linear-gradient(135deg, <%= t1 %>, <%= t2 %>);">
                <% if (card.photoUrl) { %>
                  <img src="<%= card.photoUrl %>" alt="" />
                <% } else { %>
                  <%= ((card.fullName || card.label || '?').trim().charAt(0) || '?').toUpperCase() %>
                <% } %>
              </div>
              <div class="dl-mycard-name">
                <p class="name"><%= card.fullName || card.label %></p>
                <p class="link"><%= base.replace(/^https?:\/\//,'') %>/u/<%= card.slug %></p>
              </div>
              <% if (card.active === false) { %>
                <span class="dl-badge-status cancelled">paused</span>
              <% } else { %>
                <span class="dl-badge-status fulfilled">active</span>
              <% } %>
            </div>
            <div class="dl-mycard-meta">
              <span>👁 <%= card.viewCount || 0 %> taps</span>
              <% if (card.lastViewedAt) { %><span>· last <%= new Date(card.lastViewedAt).toLocaleDateString('en-GB') %></span><% } %>
            </div>
            <div class="dl-mycard-actions">
              <button type="button" class="dl-btn secondary dl-copy-link" data-url="<%= base %>/u/<%= card.slug %>" style="padding:9px 14px; font-size:13px;">Copy link</button>
              <a href="<%= base %>/u/<%= card.slug %>" target="_blank" class="dl-btn secondary" style="padding:9px 14px; font-size:13px;">View</a>
              <a href="/my/cards/<%= card.id %>/edit" class="dl-btn primary" style="padding:9px 14px; font-size:13px;">Edit</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <h2 style="margin-top:44px; font-size:16px;">Order history</h2>
    <% if (orders.length === 0) { %>
      <div class="dl-card"><p class="dl-hint" style="margin:0;">No orders yet.</p></div>
    <% } else { %>
      <div class="dl-card" style="padding:0; overflow-x:auto;">
        <table class="dl-table">
          <thead><tr><th>Date</th><th>Type</th><th>Qty</th><th>Design</th><th>Total</th><th>Status</th></tr></thead>
          <tbody>
            <% orders.forEach(function(order) { %>
              <tr>
                <td><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></td>
                <td><%= order.kind === 'organization' ? 'Organization' : 'For myself' %></td>
                <td><%= order.quantity %></td>
                <td><%= designOptions[order.design].label %></td>
                <td><%= order.totalPriceEur.toFixed(2) %>€</td>
                <td><span class="dl-badge-status <%= order.status %>"><%= order.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <script src="/js/customer-dashboard.js"></script>
</body>
</html>
