<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit card — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
<%- include('partials/edit-header') %>

        <h2 class="dl-form-section-title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal)" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.8Z"/></svg> Google Reviews</h2>
        <div class="dl-field">
          <label for="fullName">Business name</label>
          <input type="text" id="fullName" name="fullName" value="<%= card.fullName || '' %>" />
        </div>
        <div class="dl-field">
          <label for="reviewGoogleUrl">Google review link</label>
          <input type="text" id="reviewGoogleUrl" name="reviewGoogleUrl" placeholder="https://g.page/r/.../review" value="<%= card.reviewGoogleUrl || '' %>" />
          <p class="dl-hint">Find yours in Google Business Profile → "Ask for reviews" → copy link. 4–5 star visitors are sent straight here.</p>
        </div>
        <div class="dl-field">
          <label for="reviewLowRatingMessage">Message shown to 1–3 star visitors</label>
          <textarea id="reviewLowRatingMessage" name="reviewLowRatingMessage" placeholder="Sorry to hear that. Tell us what went wrong — we'll read it personally and try to make it right."><%= card.reviewLowRatingMessage || '' %></textarea>
          <p class="dl-hint">They'll see this instead of being sent to Google, and leave you private feedback below it.</p>
        </div>
        <div class="dl-field">
          <label for="photo">Logo</label>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>

        <% if (card.reviewFeedback && card.reviewFeedback.length) { %>
          <h2 class="dl-form-section-title">Private feedback received (<%= card.reviewFeedback.length %>)</h2>
          <div class="dl-feedback-list">
            <% card.reviewFeedback.slice(0, 20).forEach(function(f) { %>
              <div class="dl-feedback-item">
                <div class="dl-feedback-stars"><%= '★'.repeat(f.rating) %><span class="dim"><%= '★'.repeat(5 - f.rating) %></span></div>
                <% if (f.comment) { %><p class="dl-feedback-comment"><%= f.comment %></p><% } %>
                <p class="dl-hint" style="margin:4px 0 0;">
                  <% if (f.contactName) { %><%= f.contactName %><% } %>
                  <% if (f.contactPhone) { %> · <%= f.contactPhone %><% } %>
                  · <%= new Date(f.createdAt).toLocaleDateString('en-GB') %>
                </p>
              </div>
            <% }) %>
          </div>
        <% } %>

<%- include('partials/appearance-editor', { card: card, kindMeta: kindMeta }) %>

<%- include('partials/edit-footer') %>
