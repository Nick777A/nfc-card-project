<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Партия <%= batchId %> — NFC Card Admin</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/admin-nav') %>
  <div class="container">
    <div class="card">
      <h1>Партия сгенерирована</h1>
      <div class="success-box">Создано карточек: <%= total %></div>
      <p class="hint">
        Закодируйте каждую ссылку в NFC-метку/QR-код физической карты. Пока карточка не активирована
        покупателем, ссылка ведёт на страницу регистрации/активации.
      </p>
      <p style="margin:16px 0;">
        <a class="btn" href="/admin/cards/stock/<%= batchId %>.csv">⬇ Скачать CSV со всеми ссылками</a>
      </p>
      <table class="cards-table">
        <thead><tr><th>Slug</th><th>Ссылка</th><th>Статус</th></tr></thead>
        <tbody>
          <% rows.slice(0, 200).forEach(function(r) { %>
            <tr>
              <td><%= r.slug %></td>
              <td><a href="<%= r.url %>" target="_blank"><%= r.url %></a></td>
              <td><%= r.claimed ? 'Активирована' : 'Свободна' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (rows.length > 200) { %>
        <p class="hint">Показаны первые 200 из <%= rows.length %> — остальные в CSV-файле.</p>
      <% } %>
      <p style="margin-top:16px;"><a href="/admin">← К списку всех карточек</a></p>
    </div>
  </div>
</body>
</html>
