<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('notFoundTitle') %></title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
  <div class="dl-profile-wrap">
    <div class="dl-profile-card dl-profile-reveal">
      <div class="dl-profile-lang">
        <select id="lang-select" aria-label="Language">
          <% languages.forEach(function(l) { %>
            <option value="<%= l.code %>" <%= l.code === lang ? 'selected' : '' %>><%= l.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="dl-avatar dl-profile-item" style="--d:1">?</div>
      <p class="dl-profile-name dl-profile-item" style="--d:2"><%= t('notFoundTitle') %></p>
      <p class="dl-hint dl-profile-item" style="--d:3"><%= t('notFoundHint') %></p>
    </div>
  </div>
  <script src="/js/lang-switcher.js"></script>
</body>
</html>
