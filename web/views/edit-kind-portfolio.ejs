<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit card — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
<%- include('partials/edit-header') %>

        <h2 class="dl-form-section-title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal)" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.4" fill="currentColor" stroke="none"/><path d="m4.5 17 4.5-4.5 3 3 4-4 4.5 4.5"/></svg> Portfolio</h2>
        <div class="dl-field">
          <label for="fullName">Your name / studio name</label>
          <input type="text" id="fullName" name="fullName" value="<%= card.fullName || '' %>" />
        </div>
        <div class="dl-field">
          <label for="tagline">Tagline</label>
          <input type="text" id="tagline" name="tagline" placeholder="e.g. Brand & product photography" value="<%= card.tagline || '' %>" />
        </div>
        <div class="dl-field">
          <label for="photo">Profile photo / logo</label>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>
        <div class="dl-field">
          <label for="portfolioText">Projects</label>
          <textarea id="portfolioText" name="portfolioText" rows="6" placeholder="Brand identity for Acme | Full visual identity and packaging | https://example.com/acme
Product shoot — Aurora | Studio photography for launch"><%= portfolioText %></textarea>
          <p class="dl-hint">One project per line: <code>Title | Description | Link (optional)</code>.</p>
        </div>
        <div class="dl-field">
          <label for="gallery">Project images (up to 6, in the same order as the list above)</label>
          <input type="file" id="gallery" name="gallery" accept="image/*" multiple />
          <% if (card.portfolioItems && card.portfolioItems.some(function(i){ return i.imageUrl; })) { %>
            <p class="dl-hint">Images already set for some projects — uploading new ones replaces all of them, in order.</p>
          <% } %>
        </div>

<%- include('partials/appearance-editor', { card: card, kindMeta: kindMeta }) %>

<%- include('partials/edit-footer') %>
