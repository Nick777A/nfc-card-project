<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit card — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
<%- include('partials/edit-header') %>

        <h2 class="dl-form-section-title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/></svg> Basics</h2>
        <div class="dl-field">
          <label for="fullName">Full name / company name</label>
          <input type="text" id="fullName" name="fullName" value="<%= card.fullName || '' %>" />
        </div>
        <div class="dl-field">
          <label for="tagline">Tagline</label>
          <input type="text" id="tagline" name="tagline" placeholder="e.g. Digital business cards" value="<%= card.tagline || '' %>" />
        </div>
        <div class="dl-row">
          <div class="dl-field">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" value="<%= card.company || '' %>" />
          </div>
          <div class="dl-field">
            <label for="jobTitle">Job title</label>
            <input type="text" id="jobTitle" name="jobTitle" value="<%= card.jobTitle || '' %>" />
          </div>
        </div>
        <div class="dl-row">
          <div class="dl-field">
            <label for="photo">Profile photo / logo</label>
            <input type="file" id="photo" name="photo" accept="image/*" />
          </div>
          <div class="dl-field">
            <label for="banner">Cover banner</label>
            <input type="file" id="banner" name="banner" accept="image/*" />
            <% if (card.bannerUrl) { %><p class="dl-hint">Banner set — upload a new one to replace it.</p><% } %>
          </div>
        </div>

        <h2 class="dl-form-section-title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.3c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.2 1.1L6.6 10.8Z"/></svg> Contact</h2>
        <div class="dl-row">
          <div class="dl-field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= card.phone || '' %>" />
          </div>
          <div class="dl-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= card.email || '' %>" />
          </div>
        </div>
        <div class="dl-field">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" placeholder="https://..." value="<%= card.website || '' %>" />
        </div>
        <div class="dl-field">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= card.address || '' %>" />
        </div>
        <div class="dl-field">
          <label for="scheduleText">Opening hours</label>
          <textarea id="scheduleText" name="scheduleText" placeholder="Mon–Fri: 9:00–18:00&#10;Sat: 10:00–14:00&#10;Sun: closed"><%= card.scheduleText || '' %></textarea>
        </div>

        <h2 class="dl-form-section-title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal)" stroke-width="1.8" stroke-linecap="round"><path d="M9 15l6-6M8.5 11 7 12.5a3 3 0 104.2 4.2L13 15M15.5 13 17 11.5a3 3 0 00-4.2-4.2L11 9"/></svg> Links & gallery</h2>
        <div class="dl-field">
          <label for="links">Links — socials, messengers, anything else (one per line)</label>
          <textarea id="links" name="links"><%= (card.links || []).map(function(l) { return typeof l === 'string' ? l : (l.label ? l.label + ' | ' + l.url : l.url); }).join('\n') %></textarea>
          <p class="dl-hint">Instagram, Facebook, TikTok, YouTube, LinkedIn, Pinterest, Reddit, Discord and dozens more socials are auto-detected under "Socials"; WhatsApp/Telegram/Viber/Signal/Skype under "Messengers". Anything else lands in the "Links" tab — give it your own description instead of the raw address: <code>My portfolio | https://example.com</code>.</p>
        </div>
        <div class="dl-field">
          <label for="gallery">Photo gallery (up to 6)</label>
          <input type="file" id="gallery" name="gallery" accept="image/*" multiple />
          <% if (card.galleryUrls && card.galleryUrls.length) { %><p class="dl-hint"><%= card.galleryUrls.length %> photo(s) uploaded — uploading new ones replaces the whole gallery.</p><% } %>
        </div>

<%- include('partials/appearance-editor', { card: card, kindMeta: kindMeta || { tagline: 'Job title · Company' } }) %>

<%- include('partials/edit-footer') %>
