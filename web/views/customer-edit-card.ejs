<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit card — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
  <nav class="dl-nav">
    <a class="dl-logo" href="/">digilama</a>
    <div class="dl-nav-links"><a href="/my">← My cards</a></div>
  </nav>

  <div class="dl-container narrow" style="padding-bottom:60px;">
    <div class="dl-card">
      <h1 style="margin-top:0;">Edit card</h1>
      <% if (error) { %><div class="dl-error"><%= error %></div><% } %>
      <form method="post" action="/my/cards/<%= card.id %>/edit" enctype="multipart/form-data">
        <div class="dl-field">
          <label for="fullName">Full name / company name</label>
          <input type="text" id="fullName" name="fullName" value="<%= card.fullName || '' %>" />
        </div>
        <div class="dl-field">
          <label for="tagline">Tagline</label>
          <input type="text" id="tagline" name="tagline" placeholder="e.g. Digital business cards" value="<%= card.tagline || '' %>" />
        </div>
        <div class="dl-field">
          <label for="banner">Cover banner</label>
          <input type="file" id="banner" name="banner" accept="image/*" />
          <% if (card.bannerUrl) { %><p class="dl-hint">Current banner is set — upload a new one to replace it.</p><% } %>
        </div>
        <div class="dl-field">
          <label for="photo">Profile photo / logo</label>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>
        <div class="dl-row">
          <div class="dl-field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= card.phone || '' %>" />
          </div>
          <div class="dl-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= card.email || '' %>" />
          </div>
        </div>
        <div class="dl-field">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" placeholder="https://..." value="<%= card.website || '' %>" />
        </div>
        <div class="dl-row">
          <div class="dl-field">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" value="<%= card.company || '' %>" />
          </div>
          <div class="dl-field">
            <label for="jobTitle">Job title</label>
            <input type="text" id="jobTitle" name="jobTitle" value="<%= card.jobTitle || '' %>" />
          </div>
        </div>
        <div class="dl-field">
          <label for="links">Links — socials, messengers, anything else (one per line)</label>
          <textarea id="links" name="links"><%= (card.links || []).map(function(l) { return typeof l === 'string' ? l : (l.label ? l.label + ' | ' + l.url : l.url); }).join('\n') %></textarea>
          <p class="dl-hint">Instagram, Facebook, TikTok, YouTube, LinkedIn, Pinterest, Reddit, Discord and dozens more socials are auto-detected under "Socials"; WhatsApp/Telegram/Viber/Signal/Skype under "Messengers". Anything else lands in the "Links" tab — give it your own description instead of the raw address: <code>My portfolio | https://example.com</code>.</p>
        </div>
        <div class="dl-field">
          <label for="gallery">Photo gallery (up to 6)</label>
          <input type="file" id="gallery" name="gallery" accept="image/*" multiple />
          <% if (card.galleryUrls && card.galleryUrls.length) { %><p class="dl-hint"><%= card.galleryUrls.length %> photo(s) uploaded — uploading new ones replaces the whole gallery.</p><% } %>
        </div>
        <div class="dl-field">
          <label for="scheduleText">Opening hours</label>
          <textarea id="scheduleText" name="scheduleText" placeholder="Mon–Fri: 9:00–18:00&#10;Sat: 10:00–14:00&#10;Sun: closed"><%= card.scheduleText || '' %></textarea>
        </div>
        <div class="dl-field">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= card.address || '' %>" />
        </div>

        <h2 style="margin:28px 0 4px; font-size:16px;">Appearance</h2>
        <p class="dl-hint" style="margin-top:0;">Choose your own colors for the public card — background, accent gradient and icons — instead of the default Digilama look.</p>
        <div class="dl-field">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
            <input type="checkbox" id="themeEnabled" name="themeEnabled" style="width:auto;" <%= card.theme ? 'checked' : '' %> />
            Use custom style
          </label>
        </div>
        <div id="theme-fields" style="<%= card.theme ? '' : 'display:none;' %>">
          <div class="dl-field">
            <label>Background</label>
            <div style="display:flex; gap:16px; align-items:center; margin-bottom:8px;">
              <label style="display:flex; align-items:center; gap:6px; font-weight:400;"><input type="radio" name="bgMode" value="solid" style="width:auto;" <%= (!card.theme || card.theme.bgMode !== 'gradient') ? 'checked' : '' %> /> Solid color</label>
              <label style="display:flex; align-items:center; gap:6px; font-weight:400;"><input type="radio" name="bgMode" value="gradient" style="width:auto;" <%= (card.theme && card.theme.bgMode === 'gradient') ? 'checked' : '' %> /> Gradient</label>
            </div>
            <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
              <input type="color" name="bgColor1" value="<%= (card.theme && card.theme.bgColor1) || '#07070b' %>" style="width:56px; height:36px; padding:2px;" />
              <input type="color" name="bgColor2" id="bgColor2" value="<%= (card.theme && card.theme.bgColor2) || '#1a1a2e' %>" style="width:56px; height:36px; padding:2px; <%= (card.theme && card.theme.bgMode === 'gradient') ? '' : 'display:none;' %>" />
              <label id="bgAngleWrap" style="display:flex; align-items:center; gap:6px; font-weight:400; <%= (card.theme && card.theme.bgMode === 'gradient') ? '' : 'display:none;' %>">
                Angle <input type="number" name="bgAngle" min="0" max="360" value="<%= (card.theme && card.theme.bgAngle) || 135 %>" style="width:70px;" />
              </label>
            </div>
          </div>
          <div class="dl-field">
            <label>Accent colors (buttons, active tab, avatar ring, icons on hover)</label>
            <div style="display:flex; gap:12px;">
              <input type="color" name="accentColor1" value="<%= (card.theme && card.theme.accentColor1) || '#ff2e88' %>" style="width:56px; height:36px; padding:2px;" />
              <input type="color" name="accentColor2" value="<%= (card.theme && card.theme.accentColor2) || '#00e6c3' %>" style="width:56px; height:36px; padding:2px;" />
            </div>
          </div>
          <div class="dl-row">
            <div class="dl-field">
              <label>Icon color</label>
              <input type="color" name="iconColor" value="<%= (card.theme && card.theme.iconColor) || '#9a9aab' %>" style="width:56px; height:36px; padding:2px;" />
            </div>
            <div class="dl-field">
              <label for="iconSize">Icon size</label>
              <select id="iconSize" name="iconSize">
                <option value="sm" <%= card.theme && card.theme.iconSize === 'sm' ? 'selected' : '' %>>Small</option>
                <option value="md" <%= !card.theme || card.theme.iconSize === 'md' ? 'selected' : '' %>>Medium</option>
                <option value="lg" <%= card.theme && card.theme.iconSize === 'lg' ? 'selected' : '' %>>Large</option>
              </select>
            </div>
          </div>
        </div>

        <button type="submit" class="dl-btn primary block">Save</button>
      </form>
    </div>
  </div>

  <script src="/js/theme-editor.js"></script>
</body>
</html>
