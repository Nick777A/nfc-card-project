<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Карточки — NFC Card Admin</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/admin-nav') %>
  <div class="container">
    <% if (usingDefaultPassword) { %>
      <div class="error-box">
        Вы всё ещё используете пароль по умолчанию (<code>admin123</code>) — сайт публичный, смените его в разделе
        <a href="/admin/change-password">«Пароль»</a>.
      </div>
    <% } %>

    <div class="row" style="justify-content: space-between; margin-bottom: 16px;">
      <h1 style="margin:0;">Карточки (<%= cards.length %>)</h1>
      <div class="row">
        <a class="btn secondary" href="/admin/cards/bulk">Массово из CSV</a>
        <a class="btn" href="/admin/cards/new">+ Новая карточка</a>
      </div>
    </div>

    <% if (cards.length > 0) { %>
      <div class="stats-overview">
        <div class="stat-tile" style="--i:0;"><strong><%= overview.total %></strong><span>всего карточек</span></div>
        <div class="stat-tile success" style="--i:1;"><strong><%= overview.active %></strong><span>активных</span></div>
        <div class="stat-tile warn" style="--i:2;"><strong><%= overview.unclaimed %></strong><span>ждут активации</span></div>
        <div class="stat-tile danger" style="--i:3;"><strong><%= overview.paused %></strong><span>на паузе</span></div>
        <div class="stat-tile" style="--i:4;"><strong><%= overview.totalViews %></strong><span>всего касаний</span></div>
      </div>

      <div class="row" style="margin-bottom: 16px; justify-content: space-between;">
        <div class="row">
          <% Object.entries(stats).forEach(function([type, count]) { %>
            <span class="badge"><%= type %>: <%= count %></span>
          <% }) %>
        </div>
        <a href="/admin/print">Распечатать все QR</a>
      </div>

      <div class="toolbar-row">
        <div class="field toolbar-search">
          <input type="text" id="search-input" placeholder="Поиск по названию, типу, адресу..." />
        </div>
        <button class="btn secondary" id="print-selected-btn" type="button" disabled>Печать выбранных</button>
      </div>
    <% } %>

    <% if (cards.length === 0) { %>
      <div class="card">
        <p>Пока нет ни одной карточки. Нажмите «Новая карточка», чтобы создать первую — займёт несколько секунд.</p>
      </div>
    <% } else {
      function cardsTable(list, tableId) { %>
      <div class="card table-scroll" style="padding:0;">
        <table class="cards-table" id="<%= tableId %>">
          <thead>
            <tr>
              <th></th>
              <th>Название</th>
              <th>Тип</th>
              <th>Ссылка</th>
              <th>Просмотры</th>
              <th>Статус</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% list.forEach(function(card) { %>
              <tr data-search="<%= [card.label, card.type, card.slug].join(' ').toLowerCase() %>">
                <td><input type="checkbox" class="card-checkbox" value="<%= card.id %>" /></td>
                <td><a href="/admin/cards/<%= card.id %>"><%= card.label %></a></td>
                <td><span class="badge"><%= card.type %></span><% if (card.kind && card.kind !== 'business') { %> <span class="badge">🔖 <%= card.kind %></span><% } %></td>
                <td><a href="/u/<%= card.slug %>" target="_blank">/u/<%= card.slug %></a></td>
                <td><%= card.viewCount || 0 %></td>
                <td>
                  <% if (card.active === false) { %>
                    <span class="badge badge-danger">пауза</span>
                  <% } else if (card.claimable && !card.customerId) { %>
                    <span class="badge">не активирована</span>
                  <% } else { %>
                    <span class="badge badge-success">активна</span>
                  <% } %>
                </td>
                <td class="row" style="gap:8px;">
                  <a href="/admin/cards/<%= card.id %>">Открыть</a>
                  <a href="/admin/cards/<%= card.id %>/edit">Изменить</a>
                  <% if (card.batchId && card.customerId) { %>
                    <form method="post" action="/admin/cards/<%= card.id %>/unclaim" class="inline-form" data-confirm="БЕЗВОЗВРАТНО удалит профиль, меню/портфолио и ВСЕ бронирования этого владельца (в отличие от «Удалить», отменить это нельзя). Сбросить карточку «<%= card.label %>»?">
                      <button type="submit" class="link-button" style="color:var(--danger, #ff6b6b);">Сбросить</button>
                    </form>
                  <% } %>
                  <form method="post" action="/admin/cards/<%= card.id %>/delete" class="inline-form" data-confirm="Удалить эту карточку? Она переместится в корзину на 30 дней.">
                    <button type="submit" class="link-button" style="color:var(--danger, #ff6b6b);">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

      <h2 style="margin:28px 0 12px;">Созданы вручную (<%= manualCards.length %>)</h2>
      <% if (manualCards.length === 0) { %>
        <div class="card"><p class="hint">Нет карточек, созданных вручную.</p></div>
      <% } else { cardsTable(manualCards, 'cards-table-manual'); } %>

      <h2 style="margin:28px 0 12px;">Сток на продажу (<%= stockCards.length %>)</h2>
      <% if (stockCards.length === 0) { %>
        <div class="card"><p class="hint">Нет сгенерированного стока. Создать: «+ Сток для продажи» в меню сверху.</p></div>
      <% } else { cardsTable(stockCards, 'cards-table-stock'); } %>
    <% } %>
  </div>
  <script src="/js/dashboard.js"></script>
</body>
</html>
