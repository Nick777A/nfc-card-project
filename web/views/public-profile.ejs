<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= card.type === 'profile' ? (card.fullName || 'Profile') : card.label %></title>
  <%- include('partials/head-digilama') %>
  <%- include('partials/og-tags') %>
</head>
<body class="digilama">
  <div class="dl-profile-wrap">
    <div class="dl-profile-card dl-profile-reveal">
      <a class="dl-profile-logo" href="/" target="_blank" rel="noopener" aria-label="Digilama">digilama</a>

      <div class="dl-profile-lang">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.5 2.7 3.8 6 3.8 9.5s-1.3 6.8-3.8 9.5c-2.5-2.7-3.8-6-3.8-9.5s1.3-6.8 3.8-9.5Z"/></svg>
        <select id="lang-select" aria-label="Language">
          <% languages.forEach(function(l) { %>
            <option value="<%= l.code %>" <%= l.code === lang ? 'selected' : '' %>><%= l.label %></option>
          <% }) %>
        </select>
      </div>

      <% var hasBanner = card.type === 'profile' && card.bannerUrl; %>
      <% if (!hasBanner) { %>
        <div class="dl-tap-badge"><span class="dot"></span> <%= t('connectedBadge') %></div>
      <% } %>

      <% if (card.type === 'profile') { %>
        <% if (card.bannerUrl) { %>
          <div class="dl-banner"><img src="<%= card.bannerUrl %>" alt="" /></div>
        <% } %>
        <div class="dl-avatar dl-profile-item <%= card.photoUrl ? 'has-photo' : '' %> <%= card.bannerUrl ? 'on-banner' : '' %>" style="--d:1">
          <span class="dl-avatar-ring"></span>
          <% if (card.photoUrl) { %>
            <img src="<%= card.photoUrl %>" alt="<%= card.fullName %>" width="104" height="104" />
          <% } else { %>
            <%= (card.fullName || '?').trim().charAt(0).toUpperCase() %>
          <% } %>
        </div>
        <% if (hasBanner) { %>
          <div class="dl-tap-badge" style="margin-top:4px;"><span class="dot"></span> <%= t('connectedBadge') %></div>
        <% } %>
        <p class="dl-profile-name dl-profile-item" style="--d:2"><%= card.fullName %></p>
        <% if (card.jobTitle || card.company) { %>
          <p class="dl-profile-sub dl-profile-item" style="--d:3; margin-bottom:2px;"><%= [card.jobTitle, card.company].filter(Boolean).join(' · ') %></p>
        <% } %>
        <% if (card.tagline) { %>
          <p class="dl-profile-sub dl-profile-item" style="--d:3"><%= card.tagline %></p>
        <% } %>

        <% if (card.phone || card.email || card.website) { %>
          <div class="dl-contact-row dl-profile-item" style="--d:4">
            <% if (card.phone) { %>
              <a class="dl-contact-item" href="tel:<%= card.phone %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.3c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.2 1.1L6.6 10.8Z"/></svg>
                <span><%= phoneDisplay %></span>
              </a>
            <% } %>
            <% if (card.email) { %>
              <a class="dl-contact-item" href="mailto:<%= card.email %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6.5 8 6 8-6"/></svg>
                <span><%= card.email %></span>
              </a>
            <% } %>
            <% if (card.website) { %>
              <a class="dl-contact-item" href="<%= card.website %>" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.8"/><path d="M2.5 12h19M12 2.5c2.5 2.7 3.8 6 3.8 9.5s-1.3 6.8-3.8 9.5c-2.5-2.7-3.8-6-3.8-9.5s1.3-6.8 3.8-9.5Z" stroke="currentColor" stroke-width="1.8"/></svg>
                <span><%= card.website.replace(/^https?:\/\//, '') %></span>
              </a>
            <% } %>
          </div>
        <% } %>

        <a class="dl-btn primary block dl-profile-item" style="--d:5" href="/u/<%= card.slug %>/vcard">⬇ <%= t('saveContact') %></a>

        <div class="dl-tabs dl-profile-item" style="--d:6">
          <button type="button" class="dl-tab active" data-tab="links">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 15l6-6M8.5 11 7 12.5a3 3 0 104.2 4.2L13 15M15.5 13 17 11.5a3 3 0 00-4.2-4.2L11 9"/></svg>
            <%= t('tabLinks') %>
          </button>
          <button type="button" class="dl-tab" data-tab="gallery">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.4" fill="currentColor" stroke="none"/><path d="m4.5 17 4.5-4.5 3 3 4-4 4.5 4.5"/></svg>
            <%= t('tabGallery') %>
          </button>
          <button type="button" class="dl-tab" data-tab="schedule">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            <%= t('tabSchedule') %>
          </button>
          <button type="button" class="dl-tab" data-tab="address">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.3"/></svg>
            <%= t('tabAddress') %>
          </button>
        </div>

        <div class="dl-tab-panel active dl-profile-item" data-panel="links" style="--d:7">
          <% if (socialLinks.length) { %>
            <div class="dl-link-section">
              <p class="dl-link-section-title"><%= t('socialsLabel') %></p>
              <div class="dl-social-row">
                <% socialLinks.forEach(function(link) { %>
                  <a class="dl-social-icon" href="<%= link.url %>" target="_blank" rel="noopener" title="<%= link.label %>"><%- link.svg %></a>
                <% }) %>
              </div>
            </div>
          <% } %>
          <% if (messengerLinks.length) { %>
            <div class="dl-link-section">
              <p class="dl-link-section-title"><%= t('messengersLabel') %></p>
              <div class="dl-social-row">
                <% messengerLinks.forEach(function(link) { %>
                  <a class="dl-social-icon" href="<%= link.url %>" target="_blank" rel="noopener" title="<%= link.label %>"><%- link.svg %></a>
                <% }) %>
              </div>
            </div>
          <% } %>
          <% if (genericLinks.length) { %>
            <div class="dl-link-section">
              <% genericLinks.forEach(function(link) { %>
                <a class="dl-link-row" href="<%= link.url %>" target="_blank" rel="noopener">
                  <%- link.svg %>
                  <span><%= link.label || link.url.replace(/^https?:\/\//, '') %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
          <% if (!socialLinks.length && !messengerLinks.length && !genericLinks.length) { %>
            <p class="dl-hint" style="text-align:center;"><%= t('noLinksYet') %></p>
          <% } %>
        </div>

        <div class="dl-tab-panel dl-profile-item" data-panel="gallery" style="--d:7">
          <% if (card.galleryUrls && card.galleryUrls.length) { %>
            <div class="dl-gallery-grid">
              <% card.galleryUrls.forEach(function(url) { %><img src="<%= url %>" alt="" /><% }) %>
            </div>
          <% } else { %>
            <p class="dl-hint" style="text-align:center;"><%= t('noPhotosYet') %></p>
          <% } %>
        </div>

        <div class="dl-tab-panel dl-profile-item" data-panel="schedule" style="--d:7">
          <% if (card.scheduleText) { %>
            <p class="dl-schedule-text"><%= card.scheduleText %></p>
          <% } else { %>
            <p class="dl-hint" style="text-align:center;"><%= t('hoursNotProvided') %></p>
          <% } %>
        </div>

        <div class="dl-tab-panel dl-profile-item" data-panel="address" style="--d:7">
          <% if (card.address) { %>
            <p class="dl-address-text"><%= card.address %></p>
            <a class="dl-btn secondary block" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(card.address) %>" target="_blank" rel="noopener"><%= t('openInMaps') %></a>
          <% } else { %>
            <p class="dl-hint" style="text-align:center;"><%= t('addressNotProvided') %></p>
          <% } %>
        </div>

      <% } else if (card.type === 'wifi') { %>
        <div class="dl-avatar dl-profile-item" style="--d:1"><span class="dl-avatar-ring"></span>📶</div>
        <p class="dl-profile-name dl-profile-item" style="--d:2"><%= card.wifiSsid %></p>
        <p class="dl-profile-sub dl-profile-item" style="--d:3"><%= t('wifiNetwork') %></p>
        <div class="dl-profile-list dl-profile-item" style="--d:4">
          <div class="dl-row-item"><span><%= t('wifiPassword') %></span><span><%= card.wifiPassword || '—' %></span></div>
        </div>
        <p class="dl-hint dl-profile-item" style="--d:5"><%= t('wifiHint') %></p>

      <% } else { %>
        <div class="dl-avatar dl-profile-item" style="--d:1"><span class="dl-avatar-ring"></span>🔗</div>
        <p class="dl-profile-name dl-profile-item" style="--d:2"><%= card.label %></p>
        <div class="dl-summary dl-profile-item" style="--d:3; text-align:left;"><%= card.customPayload %></div>
      <% } %>

      <div class="dl-qr-fallback dl-profile-item" style="--d:7">
        <p class="dl-qr-fallback-label"><%= t('qrFallbackLabel') %></p>
        <img src="<%= qrDataUrl %>" alt="QR" width="132" height="132" />
        <p class="dl-hint"><%= t('qrFallbackHint') %></p>
      </div>

      <p class="dl-hint dl-profile-item" style="--d:8; margin-top:20px; text-align:center;"><a href="/privacy"><%= t('privacyLabel') %></a></p>
    </div>
  </div>

  <script src="/js/lang-switcher.js"></script>
  <% if (card.type === 'profile') { %><script src="/js/profile-tabs.js"></script><% } %>
</body>
</html>
