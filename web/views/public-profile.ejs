<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= card.type === 'profile' ? (card.fullName || 'Profile') : card.label %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="profile-page">
    <%- include('partials/lang-switcher') %>

    <% if (card.type === 'profile') { %>
      <div class="profile-avatar"><%= (card.fullName || '?').trim().charAt(0).toUpperCase() %></div>
      <p class="profile-name"><%= card.fullName %></p>
      <% if (card.jobTitle || card.company) { %>
        <p class="profile-sub"><%= [card.jobTitle, card.company].filter(Boolean).join(' · ') %></p>
      <% } %>

      <a class="btn btn-block" href="/u/<%= card.slug %>/vcard">⬇ <%= t('saveContact') %></a>

      <div class="profile-list">
        <% if (card.phone) { %>
          <div class="row-item"><span><%= t('phoneLabel') %></span><a href="tel:<%= card.phone %>"><%= card.phone %></a></div>
        <% } %>
        <% if (card.email) { %>
          <div class="row-item"><span><%= t('emailLabel') %></span><a href="mailto:<%= card.email %>"><%= card.email %></a></div>
        <% } %>
        <% (card.links || []).forEach(function(link) { %>
          <div class="row-item"><span><%= t('linkLabel') %></span><a href="<%= link %>" target="_blank"><%= link %></a></div>
        <% }) %>
      </div>

    <% } else if (card.type === 'wifi') { %>
      <div class="profile-avatar">📶</div>
      <p class="profile-name"><%= card.wifiSsid %></p>
      <p class="profile-sub"><%= t('wifiNetwork') %></p>
      <div class="profile-list">
        <div class="row-item"><span><%= t('wifiPassword') %></span><span><%= card.wifiPassword || '—' %></span></div>
      </div>
      <p class="hint"><%= t('wifiHint') %></p>

    <% } else { %>
      <div class="profile-avatar">🔗</div>
      <p class="profile-name"><%= card.label %></p>
      <div class="payload-box" style="text-align:left; margin-top: 20px;"><%= card.customPayload %></div>
    <% } %>

    <div class="qr-fallback">
      <p class="qr-fallback-label"><%= t('qrFallbackLabel') %></p>
      <img src="<%= qrDataUrl %>" alt="QR" width="132" height="132" />
      <p class="hint"><%= t('qrFallbackHint') %></p>
    </div>
  </div>

  <script src="/js/lang-switcher.js"></script>
</body>
</html>
