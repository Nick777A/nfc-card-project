<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Код подтверждения — NFC Card Admin</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="container narrow" style="margin-top: 80px;">
    <div class="card">
      <h1>Код из приложения-аутентификатора</h1>
      <p class="hint" style="margin-top:-6px;">Введите 6-значный код из Google Authenticator / Microsoft Authenticator и т.п.</p>
      <% if (error) { %>
        <div class="error-box"><%= error %></div>
      <% } %>
      <form method="post" action="/login/2fa">
        <div class="field">
          <label for="code">Код</label>
          <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required autofocus />
        </div>
        <button type="submit" class="btn" style="width:100%;">Подтвердить</button>
      </form>
    </div>
  </div>
</body>
</html>
