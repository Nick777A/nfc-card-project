<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit card — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
<%- include('partials/edit-header') %>

        <h2 class="dl-form-section-title"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--teal)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> Booking</h2>
        <div class="dl-field">
          <label for="fullName">Your name / business name</label>
          <input type="text" id="fullName" name="fullName" value="<%= card.fullName || '' %>" />
        </div>
        <div class="dl-field">
          <label for="tagline">What are people booking?</label>
          <input type="text" id="tagline" name="tagline" placeholder="e.g. 30-minute consultation" value="<%= card.tagline || '' %>" />
        </div>
        <div class="dl-field">
          <label for="address">Location (optional)</label>
          <input type="text" id="address" name="address" value="<%= card.address || '' %>" />
        </div>
        <div class="dl-field">
          <label for="photo">Photo / logo</label>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>

        <h2 class="dl-form-section-title">Weekly availability</h2>
        <div class="dl-avail-rows">
          <% weekdays.forEach(function(day) { %>
            <% var range = (card.bookingAvailability && card.bookingAvailability[day] && card.bookingAvailability[day][0]) || null; %>
            <div class="dl-avail-row">
              <label class="dl-avail-day">
                <input type="checkbox" name="avail_<%= day %>_on" <%= range ? 'checked' : '' %> />
                <%= day.charAt(0).toUpperCase() + day.slice(1) %>
              </label>
              <input type="time" name="avail_<%= day %>_from" value="<%= range ? range.start : '09:00' %>" />
              <span class="dl-hint">to</span>
              <input type="time" name="avail_<%= day %>_to" value="<%= range ? range.end : '18:00' %>" />
            </div>
          <% }) %>
        </div>

        <div class="dl-row">
          <div class="dl-field">
            <label for="bookingDurationMin">Slot length</label>
            <select id="bookingDurationMin" name="bookingDurationMin">
              <% [15, 30, 45, 60, 90].forEach(function(m) { %>
                <option value="<%= m %>" <%= (card.bookingDurationMin || 30) === m ? 'selected' : '' %>><%= m %> min</option>
              <% }) %>
            </select>
          </div>
          <div class="dl-field">
            <label for="bookingWindowDays">Bookable up to</label>
            <select id="bookingWindowDays" name="bookingWindowDays">
              <% [7, 14, 30, 60].forEach(function(d) { %>
                <option value="<%= d %>" <%= (card.bookingWindowDays || 14) === d ? 'selected' : '' %>><%= d %> days ahead</option>
              <% }) %>
            </select>
          </div>
        </div>

        <% var upcoming = (card.bookings || []).filter(function(b) { return b.status !== 'cancelled' && b.date >= new Date().toISOString().slice(0,10); }).sort(function(a,b){ return a.date.localeCompare(b.date) || a.time.localeCompare(b.time); }); %>
        <% if (upcoming.length) { %>
          <h2 class="dl-form-section-title">Upcoming bookings (<%= upcoming.length %>)</h2>
          <div class="dl-booking-list">
            <% upcoming.forEach(function(b) { %>
              <div class="dl-booking-list-item">
                <div>
                  <p class="dl-booking-list-when"><%= b.date %> at <%= b.time %></p>
                  <p class="dl-hint" style="margin:2px 0 0;">
                    <%= b.name %><% if (b.phone) { %> · <%= b.phone %><% } %><% if (b.email) { %> · <%= b.email %><% } %>
                  </p>
                  <% if (b.note) { %><p class="dl-hint" style="margin:2px 0 0; font-style:italic;">"<%= b.note %>"</p><% } %>
                </div>
                <form method="post" action="/my/cards/<%= card.id %>/bookings/<%= b.id %>/cancel" data-confirm="Cancel this booking?">
                  <button type="submit" class="dl-btn secondary" style="padding:7px 14px; font-size:12px;">Cancel</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>

<%- include('partials/appearance-editor', { card: card, kindMeta: kindMeta }) %>

<%- include('partials/edit-footer', { extraScripts: ['/js/confirm-forms.js'] }) %>
