<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('claimTitle') %> — Digilama</title>
  <%- include('partials/head-digilama') %>
</head>
<body class="digilama">
  <nav class="dl-nav">
    <a class="dl-logo" href="/">digilama</a>
    <div class="dl-nav-links">
      <select id="lang-select" aria-label="Language" style="background:transparent;color:inherit;border:1px solid var(--border);border-radius:8px;padding:4px 8px;">
        <% languages.forEach(function(l) { %>
          <option value="<%= l.code %>" <%= l.code === lang ? 'selected' : '' %>><%= l.label %></option>
        <% }) %>
      </select>
    </div>
  </nav>

  <div class="dl-container narrow" style="padding-bottom:60px;">
    <div class="dl-card">
      <h1 style="margin-top:0;"><%= t('claimTitle') %></h1>
      <p class="dl-hint" style="font-size:14px; line-height:1.6; margin-bottom:8px;"><%= t('claimHint') %></p>
      <p style="margin:0 0 22px;">
        <span style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:700; letter-spacing:0.4px; text-transform:uppercase; color:var(--muted); background:var(--bg-elevated); border:1px solid var(--border); border-radius:999px; padding:5px 12px;">
          <%= t('claimCardIdLabel') %>: <span style="color:var(--text); font-family:monospace; letter-spacing:1px;"><%= slug.toUpperCase() %></span>
        </span>
      </p>

      <% if (error) { %><div class="dl-error"><%= error %></div><% } %>

      <% if (loggedIn) { %>
        <p class="dl-hint" style="margin-bottom:16px;"><%= t('claimAlreadyLoggedInHint') %></p>
        <form method="post" action="/u/<%= slug %>/claim">
          <button type="submit" class="dl-btn primary block"><%= t('claimAttachButton') %></button>
        </form>
        <form method="post" action="/customer/logout" style="margin-top:10px; text-align:center;">
          <input type="hidden" name="next" value="/u/<%= slug %>" />
          <button type="submit" style="background:none; border:none; color:var(--muted); font:inherit; font-size:13px; cursor:pointer; text-decoration:underline;"><%= t('claimNotYouLink') %></button>
        </form>
      <% } else { %>
        <div class="dl-tabs" style="margin:0 0 20px;">
          <button type="button" class="dl-tab claim-method-tab <%= method !== 'phone' ? 'active' : '' %>" data-method="email"><%= t('claimMethodEmail') %></button>
          <button type="button" class="dl-tab claim-method-tab <%= method === 'phone' ? 'active' : '' %>" data-method="phone"><%= t('claimMethodPhone') %></button>
        </div>
        <form method="post" action="/u/<%= slug %>/claim">
          <input type="hidden" id="claim-method-input" name="method" value="<%= method %>" />
          <div class="dl-field">
            <label for="contactName"><%= t('claimNameLabel') %></label>
            <input type="text" id="contactName" name="contactName" />
          </div>
          <div class="dl-field claim-field-email" style="<%= method === 'phone' ? 'display:none;' : '' %>">
            <label for="email"><%= t('claimEmailLabel') %></label>
            <input type="email" id="email" name="email" <%= method === 'phone' ? '' : 'required' %> />
            <p class="dl-hint"><%= t('claimEmailHint') %></p>
          </div>
          <div class="dl-field claim-field-phone" style="<%= method === 'phone' ? '' : 'display:none;' %>">
            <label for="phone"><%= t('claimPhoneLabel') %></label>
            <input type="tel" id="phone" name="phone" <%= method === 'phone' ? 'required' : '' %> />
            <p class="dl-hint"><%= t('claimPhoneHint') %></p>
          </div>
          <div class="dl-field">
            <label for="password"><%= t('claimPasswordLabel') %></label>
            <input type="password" id="password" name="password" minlength="6" required />
            <p class="dl-hint" style="color: var(--u-accent2, var(--teal));"><%= t('claimPasswordWarning') %></p>
          </div>
          <div class="dl-field">
            <label for="confirmPassword"><%= t('claimConfirmPasswordLabel') %></label>
            <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" />
          </div>
          <button type="submit" class="dl-btn primary block"><%= t('claimSubmit') %></button>
        </form>
      <% } %>
    </div>
  </div>

  <script src="/js/lang-switcher.js"></script>
  <script src="/js/claim-tabs.js"></script>
  <script src="/js/remember-login.js"></script>
</body>
</html>
