<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Восстановление доступа — NFC Card Admin</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="container narrow" style="margin-top: 80px;">
    <div class="card">
      <h1>Восстановление доступа</h1>
      <p class="hint" style="margin-top:-8px; margin-bottom:20px;">
        Введите код восстановления, который вы сохранили при создании (раздел «Пароль» в панели), и задайте новый пароль.
      </p>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <% if (success) { %>
        <div class="success-box"><%= success %></div>
        <p><a href="/login">← Войти</a></p>
      <% } else { %>
        <form method="post" action="/forgot-password">
          <div class="field">
            <label for="recoveryCode">Код восстановления</label>
            <input type="text" id="recoveryCode" name="recoveryCode" placeholder="XXXX-XXXX-XXXX-XXXX" required autocomplete="off" />
          </div>
          <div class="field">
            <label for="newPassword">Новый пароль</label>
            <input type="password" id="newPassword" name="newPassword" required minlength="6" />
          </div>
          <div class="field">
            <label for="confirmPassword">Повторите новый пароль</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" />
          </div>
          <button type="submit" class="btn" style="width:100%;">Сбросить пароль</button>
        </form>
        <p class="hint" style="margin-top:16px; text-align:center;"><a href="/login">← Назад ко входу</a></p>
      <% } %>
    </div>
  </div>
</body>
</html>
