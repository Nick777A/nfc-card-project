<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Отзывы и фидбэк — NFC Card Admin</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/admin-nav') %>
  <div class="container">
    <h1 style="margin-bottom:16px;">Отзывы и фидбэк (<%= entries.length %>)</h1>
    <p class="hint" style="margin-top:-8px; margin-bottom:20px;">
      Сюда попадают сообщения с карточек типа «Reviews & Feedback», у которых владелец выбрал вариант
      «Оставить внутри Digilama» вместо ссылки на Google.
    </p>

    <% if (entries.length === 0) { %>
      <div class="card"><p>Пока нет ни одного отзыва.</p></div>
    <% } else { %>
      <div class="card" style="padding:0;">
        <table class="cards-table">
          <thead>
            <tr>
              <th>Дата</th>
              <th>Карточка</th>
              <th>Имя</th>
              <th>Сообщение</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(function(e) { %>
              <tr>
                <td style="white-space:nowrap;"><%= new Date(e.createdAt).toLocaleString('ru-RU') %></td>
                <td style="white-space:nowrap;"><a href="/u/<%= e.cardSlug %>" target="_blank"><%= e.cardLabel %></a></td>
                <td style="white-space:nowrap;"><%= e.name || '—' %></td>
                <td style="white-space:normal; min-width:280px;"><%= e.comment %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
