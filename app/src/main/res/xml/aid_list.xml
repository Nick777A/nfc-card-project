<?xml version="1.0" encoding="utf-8"?>
<!--
    Regular NDEF Tag Application AID (NFC Forum Type 4 Tag), registered in the
    "other" category so this HCE service emulates a standard read-only NDEF tag
    that any NFC reader (including another instance of this app in reader mode)
    can select and read without needing a custom AID negotiation step.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_description"
    android:requireDeviceUnlock="false">
    <aid-group
        android:category="other"
        android:description="@string/hce_service_description">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
